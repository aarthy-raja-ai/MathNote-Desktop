{
  "name": "mathnote-desktop",
  "version": "1.5.0",
  "description": "MathNote Desktop — Business Finance Manager",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node dev-runner.js",
    "build": "tsc && vite build && electron-builder",
    "preview": "vite preview",
    "electron:dev": "npm run dev"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.98.0",
    "@types/qrcode": "^1.5.6",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.2.1",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0",
    "wait-on": "^9.0.4"
  },
  "build": {
    "appId": "com.aarthyraja.mathnote-desktop",
